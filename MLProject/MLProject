name: bank-marketing-ci

conda_env: conda.yaml

entry_points:
  main:
    parameters:
      n_estimators: {type: int, default: 100}
      max_depth: {type: int, default: 16}
      min_samples_leaf: {type: int, default: 5}
      data_dir: {type: string, default: bank_marketing_preprocessing}
    command: "python modelling.py --n_estimators {n_estimators} --max_depth {max_depth} --min_samples_leaf {min_samples_leaf} --data_dir {data_dir}"
